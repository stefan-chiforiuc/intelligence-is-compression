<?xml version="1.0" encoding="UTF-8"?>
<!--
  A deliberately SMALL Spring Boot app, for two measurements the rest of this
  repo cannot make:

    1. What a real framework's cold start actually costs. `Hello.java` boots in
       tens of milliseconds; nobody ships Hello.java. This is the honest number.
    2. What a request thread pool does under load, and what virtual threads
       change about it.

  Kept to starter-web + actuator + jdbc so the build stays small and the
  startup number is a floor, not a strawman: a real service with security,
  JPA, Kafka and 40 @Configuration classes starts far slower than this.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>training</groupId>
  <artifactId>spring-cold-start</artifactId>
  <version>1.0.0</version>
  <name>spring-cold-start</name>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Exposes /actuator/metrics so the room can watch the thread pool and
         the Hikari pool saturate in real time. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Optional: only used by /db. Brings HikariCP, which is the whole point
         of the "virtual threads did not enlarge your database" lesson. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
